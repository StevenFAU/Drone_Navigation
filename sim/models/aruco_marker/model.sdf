<?xml version="1.0"?>
<sdf version="1.9">
  <!-- Origin is on the ground under the post. The marker faces the model's +x axis,
       its centre is 1.5 m up. The marker square (black border included) is 0.20 m,
       on a 0.30 m white board, like a printed sheet taped to a board.
       Regenerate the texture with sim/tools/make_marker.py. -->
  <model name="aruco_marker">
    <static>true</static>
    <link name="link">
      <visual name="post">
        <pose>-0.03 0 0.675 0 0 0</pose>
        <geometry><cylinder><radius>0.02</radius><length>1.35</length></cylinder></geometry>
        <material><ambient>0.3 0.3 0.3 1</ambient><diffuse>0.3 0.3 0.3 1</diffuse></material>
      </visual>
      <visual name="board">
        <pose>0 0 1.5 0 0 0</pose>
        <geometry><box><size>0.02 0.30 0.30</size></box></geometry>
        <material>
          <ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse><specular>0 0 0 1</specular>
        </material>
      </visual>
      <visual name="marker">
        <pose>0.0105 0 1.5 0 0 0</pose>
        <geometry><plane><normal>1 0 0</normal><size>0.20 0.20</size></plane></geometry>
        <material>
          <ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse><specular>0 0 0 1</specular>
          <pbr><metal>
            <albedo_map>materials/textures/marker.png</albedo_map>
            <roughness>1.0</roughness><metalness>0.0</metalness>
          </metal></pbr>
        </material>
      </visual>
      <collision name="board">
        <pose>0 0 0.825 0 0 0</pose>
        <geometry><box><size>0.06 0.30 1.65</size></box></geometry>
      </collision>
    </link>
  </model>
</sdf>
